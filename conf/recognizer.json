{
  "app": {
    "name": "city-wall-recognizer",
    "env": "dev"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "recognition": {
    "model_version": "yolo_baseline_001",
    "weights_path": "models/yolo_baseline_001.pt",
    "confidence_threshold": 0.35,
    "max_image_bytes": 10485760,
    "allowed_formats": ["jpeg", "png", "webp"]
  },
  "internal": {
    "require_token": false,
    "token": ""
  }
}

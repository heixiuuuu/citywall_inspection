{
  "app": {
    "name": "city-wall-recognizer",
    "env": "dev"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 4100
  },
  "recognition": {
    "model_version": "yolo_baseline_001",
    "detector_mode": "yolo",
    "weights_path": "data/yolo/weights/best.pt",
    "confidence_threshold": 0.35,
    "max_image_bytes": 10485760,
    "allowed_formats": [
      "jpeg",
      "png",
      "webp"
    ]
  },
  "internal": {
    "require_token": false,
    "token": ""
  }
}

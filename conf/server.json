{
  "app": {
    "name": "city-wall-server",
    "env": "dev"
  },
  "server": {
    "listen": ":8080",
    "read_timeout_s": 30,
    "write_timeout_s": 30,
    "graceful_shutdown_s": 10
  },
  "database": {
    "driver": "mysql",
    "host": "127.0.0.1",
    "port": 3306,
    "user": "city_wall",
    "password": "city_wall_dev",
    "dbname": "city_wall",
    "charset": "utf8mb4",
    "required": false,
    "max_open_conns": 20,
    "max_idle_conns": 5,
    "conn_max_lifetime_min": 60,
    "log_level": "warn"
  },
  "storage": {
    "image_dir": "data/storage/images",
    "report_dir": "data/storage/reports",
    "temp_dir": "data/storage/tmp",
    "max_image_bytes": 10485760,
    "allowed_media_types": ["image/jpeg", "image/png", "image/webp"]
  },
  "recognizer": {
    "base_url": "http://127.0.0.1:4100",
    "internal_token": "change-me-internal-token",
    "timeout_s": 15,
    "max_retries": 1
  },
  "auth": {
    "jwt_secret": "dev-only-secret-please-change",
    "token_ttl_hours": 72,
    "wechat_app_id": "",
    "wechat_app_secret": ""
  },
  "upload": {
    "max_body_bytes": 15728640,
    "idempotency_key_header": "Idempotency-Key",
    "request_id_header": "X-Request-Id"
  },
  "report": {
    "generation_timeout_s": 30
  },
  "log": {
    "level": "info",
    "format": "text",
    "output": "stdout"
  },
  "cors": {
    "allowed_origins": ["http://localhost:5173"]
  }
}
